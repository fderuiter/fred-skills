{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditSessionDiagnosticBundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "timestamp",
    "failure_classification",
    "environment",
    "recovery",
    "scrubbed_transcript"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "session_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "failure_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "failure_type",
        "summary",
        "line_number"
      ],
      "properties": {
        "failure_type": {
          "type": "string",
          "enum": [
            "tool_timeout",
            "schema_validation_error",
            "context_limit",
            "unclassified_failure"
          ]
        },
        "summary": {
          "type": "string"
        },
        "line_number": {
          "type": "integer",
          "minimum": 1
        },
        "matched_line": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "correlated_domain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "specialist_skill": {
          "type": ["string", "null"]
        },
        "topic": {
          "type": ["string", "null"]
        },
        "ledger_references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "python_version"
      ],
      "properties": {
        "platform": {
          "type": "string"
        },
        "python_version": {
          "type": "string"
        },
        "repository_path": {
          "type": ["string", "null"]
        },
        "run_id": {
          "type": ["string", "null"]
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructions"
      ],
      "properties": {
        "last_checkpoint": {
          "type": ["string", "null"]
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scrubbed_transcript": {
      "type": "string"
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "credentials_redacted",
        "tool_outputs_omitted",
        "total_redactions"
      ],
      "properties": {
        "tier": {
          "type": "string",
          "enum": [
            "skeleton",
            "evidence",
            "full"
          ]
        },
        "credentials_redacted": {
          "type": "integer",
          "minimum": 0
        },
        "tool_outputs_omitted": {
          "type": "integer",
          "minimum": 0
        },
        "total_redactions": {
          "type": "integer",
          "minimum": 0
        },
        "by_category": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "transcript_discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "selected_transcript",
        "selection_reason",
        "rejected_candidates"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "explicit",
            "workspace",
            "claude-code",
            "codex"
          ]
        },
        "selected_transcript": {
          "type": "string"
        },
        "selection_reason": {
          "type": "string"
        },
        "rejected_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "reason"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
