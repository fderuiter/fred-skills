{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Remediation Reconciliation Output Format Schema",
  "type": "object",
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "finding_fingerprint_matches",
        "remediation_state_transitions",
        "unmapped_records"
      ]
    },
    {
      "required": [
        "schema_version",
        "records"
      ]
    }
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "finding_id",
          "fingerprint",
          "state",
          "note",
          "verification"
        ],
        "properties": {
          "at": {
            "type": "string",
            "minLength": 1
          },
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "in-progress",
              "fixed-pending-verification",
              "verified-fixed",
              "regressed",
              "accepted-risk"
            ]
          },
          "note": {
            "type": "string"
          },
          "verification": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "before_revision",
                  "after_revision",
                  "original_reproduced",
                  "regression_passed",
                  "safe_controls_passed",
                  "commands",
                  "result"
                ],
                "properties": {
                  "schema_version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "finding_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "before_revision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "after_revision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "original_reproduced": {
                    "type": "boolean"
                  },
                  "regression_passed": {
                    "type": "boolean"
                  },
                  "safe_controls_passed": {
                    "type": "boolean"
                  },
                  "commands": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "result": {
                    "type": "string",
                    "minLength": 1
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            ]
          }
        },
        "if": {
          "properties": {
            "state": {
              "const": "verified-fixed"
            }
          },
          "required": [
            "state"
          ]
        },
        "then": {
          "properties": {
            "verification": {
              "type": "object",
              "properties": {
                "original_reproduced": {
                  "const": true
                },
                "regression_passed": {
                  "const": true
                },
                "safe_controls_passed": {
                  "const": true
                }
              }
            }
          }
        }
      }
    },
    "finding_fingerprint_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fingerprint",
          "finding_id"
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "match_status": {
            "type": "string",
            "enum": [
              "exact",
              "ambiguous",
              "unmatched"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "fingerprint_matches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fingerprint": {
            "type": "string"
          },
          "finding_id": {
            "type": "string"
          }
        }
      }
    },
    "remediation_state_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "previous_state",
          "new_state"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "previous_state": {
            "type": "string",
            "enum": [
              "open",
              "in-progress",
              "fixed-pending-verification",
              "verified-fixed",
              "regressed",
              "accepted-risk",
              "unknown"
            ]
          },
          "new_state": {
            "type": "string",
            "enum": [
              "open",
              "in-progress",
              "fixed-pending-verification",
              "verified-fixed",
              "regressed",
              "accepted-risk"
            ]
          },
          "reason": {
            "type": "string"
          },
          "verification_proof": {
            "type": "string"
          }
        }
      }
    },
    "state_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "new_state": {
            "type": "string"
          }
        }
      }
    },
    "unmapped_records": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record_id",
              "reason"
            ],
            "properties": {
              "record_id": {
                "type": "string",
                "minLength": 1
              },
              "fingerprint": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "details": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
