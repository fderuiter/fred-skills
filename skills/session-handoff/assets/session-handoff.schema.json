{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session Handoff Artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "objective",
    "repository",
    "verified_facts",
    "assumptions",
    "completed_steps",
    "dead_ends",
    "touched_files",
    "untouched_scope",
    "commands_run",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "revision",
        "dirty"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verified_facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "completed_steps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dead_ends": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis",
          "reason_rejected"
        ],
        "properties": {
          "hypothesis": {
            "type": "string",
            "minLength": 1
          },
          "reason_rejected": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "touched_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "untouched_scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands_run": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "outcome"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "informational"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1
    }
  }
}
