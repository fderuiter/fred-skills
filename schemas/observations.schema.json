{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Imported Scanner Observations Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observations",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "tool_version",
        "rule",
        "reported_level",
        "message",
        "locations",
        "evidence_state"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "fail",
            "open",
            "review",
            "informational"
          ]
        },
        "reported_level": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "note",
            "none"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "line"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "end_line": {
                "type": "integer",
                "minimum": 1
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "evidence_state": {
          "type": "string",
          "minLength": 1
        },
        "security_severity": {
          "type": [
            "string",
            "number"
          ]
        },
        "fingerprints": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "partial_fingerprints": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "suppressions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "status"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "inSource",
                  "external"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "underReview",
                  "rejected"
                ]
              },
              "justification": {
                "type": "string",
                "minLength": 1
              },
              "guid": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "properties": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "findingId": {
              "type": "string",
              "minLength": 1
            },
            "topic": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "minLength": 1
            },
            "severity": {
              "type": "string",
              "minLength": 1
            },
            "confidence": {
              "type": "string",
              "minLength": 1
            },
            "remedy": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
