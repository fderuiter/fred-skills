{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Imported SARIF Scanner Observations Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observations",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "line"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "suppression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "status"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "inSource",
            "external"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "underReview",
            "rejected"
          ]
        },
        "justification": {
          "type": "string"
        },
        "guid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "audit_properties": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "findingId": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "string",
          "minLength": 1
        },
        "remedy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "tool_version",
        "rule",
        "reported_level",
        "message",
        "locations",
        "evidence_state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "tool_version": {
          "type": "string"
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "fail",
            "open",
            "review",
            "informational"
          ]
        },
        "reported_level": {
          "type": "string",
          "enum": [
            "none",
            "note",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "evidence_state": {
          "type": "string",
          "minLength": 1
        },
        "security_severity": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "number"
            }
          ]
        },
        "fingerprints": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "partial_fingerprints": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "suppressions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/suppression"
          }
        },
        "properties": {
          "$ref": "#/$defs/audit_properties"
        }
      }
    }
  }
}
