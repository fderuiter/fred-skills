{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic",
    "scenarios"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "execution_state": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^.+-failure$"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^.+-safe$"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^.+-routing$"
              }
            }
          }
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prompt",
          "expected_behavior",
          "evaluation_note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-(?:failure|safe|routing)$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "fixture_shape": {
            "type": "string",
            "minLength": 1
          },
          "sibling_skill": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "expected_behavior": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evaluation_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "if": {
          "properties": {
            "id": {
              "pattern": "-routing$"
            }
          },
          "required": [
            "id"
          ]
        },
        "then": {
          "required": [
            "sibling_skill"
          ],
          "properties": {
            "prompt": {
              "minLength": 20
            }
          }
        }
      }
    }
  }
}
