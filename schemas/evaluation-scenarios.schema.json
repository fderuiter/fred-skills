{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic",
    "scenarios"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "execution_state": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prompt",
          "expected_behavior"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "fixture_shape": {
            "type": "string",
            "minLength": 1
          },
          "expected_behavior": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evaluation_note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
