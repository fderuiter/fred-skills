{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "state",
    "toolkit_version",
    "repository",
    "snapshot",
    "capabilities",
    "plan",
    "authority",
    "checkpoints",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "planned",
        "running",
        "paused",
        "completed"
      ]
    },
    "toolkit_version": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "object",
      "required": [
        "path",
        "revision",
        "dirty"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "required": [
        "digest",
        "files",
        "skipped",
        "exclude",
        "complete",
        "max_files",
        "max_file_bytes"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "skipped": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "complete": {
          "type": "boolean"
        },
        "max_files": {
          "type": "integer",
          "minimum": 1
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "capabilities": {
      "type": "object"
    },
    "plan": {
      "type": "object",
      "required": [
        "task",
        "mode",
        "budget",
        "skills",
        "deferred_skills",
        "critical_workflows",
        "expected_outputs"
      ],
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "explore",
            "changes",
            "investigate",
            "comprehensive"
          ]
        },
        "budget": {
          "enum": [
            "brief",
            "balanced",
            "deep"
          ]
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deferred_skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "critical_workflows": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_changes",
        "issue_publication"
      ],
      "properties": {
        "application_changes": {
          "type": "boolean"
        },
        "issue_publication": {
          "type": "boolean"
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "state",
          "note"
        ],
        "properties": {
          "at": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "running",
              "paused",
              "completed"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
