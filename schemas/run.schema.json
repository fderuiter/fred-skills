{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "state",
    "toolkit_version",
    "repository",
    "snapshot",
    "capabilities",
    "plan",
    "authority",
    "checkpoints",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "planned",
        "running",
        "paused",
        "completed"
      ]
    },
    "toolkit_version": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "object",
      "required": [
        "path",
        "revision",
        "dirty"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "snapshot": {
      "type": "object",
      "required": [
        "digest",
        "files",
        "skipped",
        "exclude",
        "complete",
        "max_files",
        "max_file_bytes"
      ],
      "properties": {
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "skipped": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "complete": {
          "type": "boolean"
        },
        "max_files": {
          "type": "integer",
          "minimum": 1
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "capabilities": {
      "type": "object"
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifests",
        "packages",
        "errors"
      ],
      "properties": {
        "manifests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "ecosystem",
              "packages"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "ecosystem": {
                "type": "string",
                "minLength": 1
              },
              "packages": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "packages": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "errors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "task",
        "mode",
        "budget",
        "skills",
        "deferred_skills",
        "critical_workflows",
        "expected_outputs"
      ],
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "explore",
            "changes",
            "investigate",
            "comprehensive"
          ]
        },
        "budget": {
          "enum": [
            "brief",
            "balanced",
            "deep"
          ]
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deferred_skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "critical_workflows": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expected_outputs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "directory": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "allowed_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "do_not_modify_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "issue_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "application_changes",
        "issue_publication"
      ],
      "properties": {
        "application_changes": {
          "type": "boolean"
        },
        "issue_publication": {
          "type": "boolean"
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "state",
          "note"
        ],
        "properties": {
          "at": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "running",
              "paused",
              "completed"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "completed_skills": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "active_phase": {
            "type": "integer",
            "minimum": 0
          },
          "remaining_skills": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "single_task",
        "active_index",
        "tasks",
        "snapshot_history"
      ],
      "properties": {
        "single_task": {
          "type": "boolean"
        },
        "active_index": {
          "type": "integer",
          "minimum": 0
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skill",
              "status"
            ],
            "properties": {
              "skill": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "active",
                  "completed"
                ]
              },
              "started_at": {
                "type": "string",
                "minLength": 1
              },
              "completed_at": {
                "type": "string",
                "minLength": 1
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "snapshot_history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "pass_index",
              "skill",
              "snapshot_digest",
              "revision",
              "dirty",
              "changed_files"
            ],
            "properties": {
              "at": {
                "type": "string",
                "minLength": 1
              },
              "pass_index": {
                "type": "integer",
                "minimum": 0
              },
              "skill": {
                "type": "string",
                "minLength": 1
              },
              "snapshot_digest": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "minLength": 1
              },
              "dirty": {
                "type": "boolean"
              },
              "changed_files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
